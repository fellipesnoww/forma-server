# Aplicacao
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug

# Documentacao OpenAPI em /docs (padrao: habilitada fora de producao)
ENABLE_SWAGGER=true

# Banco de dados (usado pelo docker-compose e pela aplicacao)
POSTGRES_USER=forma
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=forma_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forma:troque_esta_senha@localhost:5432/forma_db

# Acima deste tempo de resposta (ms), GET /health/db reporta "degraded"
DB_HEALTH_DEGRADED_MS=250

# Autenticacao JWT - minimo 32 caracteres cada.
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque_este_segredo_de_acesso_com_no_minimo_32_chars
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_com_no_minimo_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth - client id de cada provedor, usado para validar o `aud` do token recebido.
# Google: console.cloud.google.com > APIs & Services > Credentials.
# Apple: developer.apple.com > Certificates, Identifiers & Profiles (Services ID / bundle id).
# Aceita varios separados por virgula: o `aud` do token precisa bater com um deles.
# No mobile o id token do Google vem com `aud` = client id WEB (o `webClientId` do app).
GOOGLE_CLIENT_ID=troque_pelo_client_id_google
APPLE_CLIENT_ID=troque_pelo_client_id_apple

# Midia. MEDIA_STORAGE_DRIVER=s3 (padrao) grava no bucket privado e as respostas trazem
# URLs pre-assinadas de GET (validas por MEDIA_URL_TTL_SECONDS);
# =database grava no Postgres (bytea) e serve por GET /media/<uuid> - so testes/dev sem AWS.
# MEDIA_MAX_SIZE_MB limita o arquivo DECODIFICADO (o base64 enviado e ~33% maior).
MEDIA_STORAGE_DRIVER=s3
MEDIA_MAX_SIZE_MB=5
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# So driver database: prefixo das URLs (vazio = relativo, /media/<uuid>).
MEDIA_PUBLIC_BASE_URL=

# AWS S3 (driver s3). Bucket PRIVADO: deixe "Block all public access" ligado, sem bucket
# policy publica. O usuario IAM do servidor precisa de s3:PutObject, s3:GetObject (as URLs
# pre-assinadas herdam essa permissao) e s3:DeleteObject em arn:aws:s3:::<bucket>/media/*.
# Legado bytea -> S3: yarn media:migrate-s3 [--dry-run]
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_KEY_PREFIX=media
# Validade das URLs pre-assinadas, em segundos (60 a 604800)
MEDIA_URL_TTL_SECONDS=3600
# S3 compativel (MinIO, LocalStack, R2). Vazio = AWS.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Registro retroativo (Fase 2.3): limite em dias para performedAt no passado.
# Vazio = sem limite.
RETROACTIVE_MAX_DAYS=

# Calendario (Fase 2.2): miniaturas de foto por dia em GET /calendar
CALENDAR_MAX_THUMBNAILS=3

# Seed de contas privilegiadas (`yarn db:seed`). Sem email/senha o seeder daquele papel e
# pulado. Senha: 8+ chars, letra e digito. So o super_user promove outros pela API.
SUPER_USER_EMAIL=spforma@forma.dev
SUPER_USER_PASSWORD=forma123App
SUPER_USER_DISPLAY_NAME=Super Admin
ADMIN_EMAIL=admin@forma.dev
ADMIN_PASSWORD=forma123App
ADMIN_DISPLAY_NAME=Admin

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_UPLOAD_MAX=10

# Estimativa de calorias por IA (dietas). Sem chave, POST /diets/calorie-estimate responde
# 503 e o resto da feature funciona. CALORIE_AI_PROVIDER vazio = primeiro com chave.
CALORIE_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CALORIE_AI_TIMEOUT_MS=30000
