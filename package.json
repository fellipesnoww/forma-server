{
  "name": "forma-server",
  "version": "0.1.0",
  "description": "Backend do Forma - plataforma de gerenciamento de treinos e atividades fisicas",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "yarn clean && prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "NODE_ENV=test LOG_LEVEL=fatal RATE_LIMIT_MAX=100000 RATE_LIMIT_UPLOAD_MAX=1000 tsx --test 'test/**/*.test.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "token:dev": "tsx src/dev/mint-token.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/node": "^24.0.13",
    "@types/pg": "^8.23.1",
    "eslint": "^9.31.0",
    "eslint-config-airbnb-extended": "^2.1.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^17.24.0",
    "husky": "^9.1.7",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0"
  }
}
