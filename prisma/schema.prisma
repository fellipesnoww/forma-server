// Schema do Prisma para o Forma.
// Convencao: modelos em PascalCase no client, tabelas/colunas em snake_case no Postgres (@map/@@map).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // moduleResolution NodeNext exige a extensao .js nos imports relativos do codigo gerado
  importFileExtension = "js"
}

// Prisma 7 removeu `url` daqui: a conexao vem do driver adapter definido em prisma.config.ts
datasource db {
  provider = "postgresql"
}

/// Arquivo binario armazenado no proprio Postgres (bytea).
/// Fase 0 nao usa S3/R2: o client envia base64, o servidor decodifica e persiste aqui.
/// `owner_id` referencia o futuro `users.id` (Fase 1.1) e por isso ainda nao tem FK.
model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  filename  String?  @db.VarChar(255)
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@map("media_assets")
}

enum Role {
  user
  admin
  super_user

  @@map("role")
}

enum UserStatus {
  active
  inactive
  banned

  @@map("user_status")
}

enum OAuthProvider {
  google
  apple

  @@map("oauth_provider")
}

/// Conta de usuario (Fase 1.1). Email/senha e OAuth (Google/Apple) convivem na mesma linha:
/// uma conta criada por um metodo pode ser vinculada ao outro sem duplicar o usuario.
/// `email` e sempre normalizado (lowercase) pela camada de aplicacao antes de gravar/ler —
/// evita depender de `citext` ou indice de expressao so para unicidade case-insensitive.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String?        @map("password_hash")
  oauthProvider OAuthProvider? @map("oauth_provider")
  oauthSubject  String?        @map("oauth_subject") @db.VarChar(255)
  role          Role           @default(user)
  status        UserStatus     @default(active)
  /// Incrementado no logout; refresh tokens carregam o valor vigente no momento da emissao
  /// (`tv`) e sao recusados se nao baterem — invalida toda sessao sem precisar de uma
  /// tabela de refresh tokens.
  tokenVersion  Int            @default(0) @map("token_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile          UserProfile?
  bodyMeasurements BodyMeasurement[]
  customExercises  CustomExercise[]
  workoutSheets    WorkoutSheet[]
  workoutSessions  WorkoutSession[]
  activityTypes    ActivityType[]
  freeActivities   FreeActivity[]
  auditLogs        AdminAuditLog[]
  achievements     UserAchievement[]
  challenges       UserChallenge[]
  diets            Diet[]
  ratings      Rating[]

  @@unique([oauthProvider, oauthSubject])
  @@map("users")
}

/// Dados de perfil separados de `users` porque a Fase 1.2 adiciona medidas corporais aqui
/// sem inflar a tabela de autenticacao. `weightKg`..`chestCm` guardam sempre o valor mais
/// recente; o historico completo fica em `BodyMeasurement`.
model UserProfile {
  userId                String    @id @map("user_id") @db.Uuid
  displayName           String?   @map("display_name") @db.VarChar(120)
  avatarUrl             String?   @map("avatar_url")
  weightKg              Float?    @map("weight_kg")
  heightCm              Float?    @map("height_cm")
  waistCm               Float?    @map("waist_cm")
  chestCm               Float?    @map("chest_cm")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  /// Fuso IANA do usuario (Fase 2.2): define em que dia local cai cada `performedAt` no
  /// calendario e na progressao. Default pt-BR porque o produto e brasileiro.
  timezone              String    @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Historico append-only de medidas corporais (Fase 1.2). Cada `POST /profile/measurements`
/// cria uma linha aqui e sincroniza os campos atuais em `UserProfile`.
model BodyMeasurement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weightKg  Float?   @map("weight_kg")
  heightCm  Float?   @map("height_cm")
  waistCm   Float?   @map("waist_cm")
  chestCm   Float?   @map("chest_cm")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("body_measurements")
}

/// Catalogo global de grupos musculares (Fase 1.3). So admin gerencia (Fase 3); usuario le.
model MuscleGroup {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(80)
  slug String @unique @db.VarChar(80)

  exercises       Exercise[]
  customExercises CustomExercise[]

  @@map("muscle_groups")
}

/// Catalogo global de exercicios (Fase 1.3), somente leitura para `user`. Edicao fica para
/// o painel admin (Fase 3) — aqui so existe leitura e o seed inicial.
model Exercise {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(160)
  muscleGroupId String?  @map("muscle_group_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  mediaUrl      String?  @map("media_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  muscleGroup      MuscleGroup?      @relation(fields: [muscleGroupId], references: [id])
  sheetExercises   SheetExercise[]
  sessionExercises SessionExercise[]

  @@unique([name])
  @@index([muscleGroupId])
  @@map("exercises")
}

/// Exercicio personalizado (Fase 1.3), isolado por `userId` — nunca visivel a outro usuario.
/// Soft delete via `deletedAt` porque pode estar referenciado em planilhas/sessoes existentes.
model CustomExercise {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String    @db.VarChar(160)
  muscleGroupId String?   @map("muscle_group_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroup      MuscleGroup?      @relation(fields: [muscleGroupId], references: [id])
  sheetExercises   SheetExercise[]
  sessionExercises SessionExercise[]

  @@index([userId, deletedAt])
  @@map("custom_exercises")
}

/// Planilha de treino do usuario (Fase 1.4). Soft delete: planilhas antigas podem ser
/// referenciadas por sessoes ja registradas (Fase 1.5).
model WorkoutSheet {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(120)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     SheetDay[]
  sessions WorkoutSession[]

  @@index([userId, deletedAt])
  @@map("workout_sheets")
}

/// Dia de treino dentro de uma planilha. `weekday` e unico por planilha (0 = domingo .. 6 = sabado).
model SheetDay {
  id        String   @id @default(uuid()) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  weekday   Int
  order     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sheet     WorkoutSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  exercises SheetExercise[]

  @@unique([sheetId, weekday])
  @@map("sheet_days")
}

/// Exercicio dentro de um dia de planilha. Referencia exatamente um de `exerciseId`
/// (catalogo) ou `customExerciseId` (do dono da planilha) — validado na camada de servico,
/// nao via CHECK constraint (Prisma nao gera CHECK a partir do schema; a app ja precisa
/// validar posse do custom exercise, entao a exclusividade fica no mesmo lugar).
model SheetExercise {
  id                 String  @id @default(uuid()) @db.Uuid
  dayId              String  @map("day_id") @db.Uuid
  exerciseId         String? @map("exercise_id") @db.Uuid
  customExerciseId   String? @map("custom_exercise_id") @db.Uuid
  sortOrder          Int     @map("sort_order")
  targetSets         Int?    @map("target_sets")
  targetReps         Int?    @map("target_reps")
  /// Descanso padrao entre series (Fase 5.1), em segundos — so alimenta o cronometro do client.
  defaultRestSeconds Int?    @map("default_rest_seconds")

  day            SheetDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise       Exercise?       @relation(fields: [exerciseId], references: [id])
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  @@index([dayId, sortOrder])
  @@map("sheet_exercises")
}

/// Sessao de treino executada a partir de uma planilha (Fase 1.5). `performedAt` aceita valor
/// passado (registro retroativo) e e o eixo do historico; `completedAt` marca a finalizacao e
/// e o que torna `POST /complete` idempotente. A planilha pode ter sido removida (soft delete)
/// depois — a sessao continua valida e apontando para ela.
model WorkoutSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sheetId         String    @map("sheet_id") @db.Uuid
  performedAt     DateTime  @default(now()) @map("performed_at") @db.Timestamptz(3)
  photoUrl        String?   @map("photo_url")
  comment         String?   @db.VarChar(1000)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  /// Duracao em minutos: informada pelo client (registro retroativo) ou calculada no
  /// `complete` a partir de `performedAt` quando a sessao foi executada ao vivo.
  durationMinutes Int?      @map("duration_minutes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet     WorkoutSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  @@index([userId, performedAt])
  @@index([sheetId])
  @@map("workout_sessions")
}

/// Exercicio executado numa sessao. Mesma regra de referencia de `SheetExercise`: exatamente
/// um de `exerciseId`/`customExerciseId`, validado na camada de servico. Nao aponta para o
/// `SheetExercise` de origem porque o usuario pode trocar/adicionar exercicios na execucao e
/// a planilha pode ser editada depois sem reescrever o historico.
model SessionExercise {
  id               String  @id @default(uuid()) @db.Uuid
  sessionId        String  @map("session_id") @db.Uuid
  exerciseId       String? @map("exercise_id") @db.Uuid
  customExerciseId String? @map("custom_exercise_id") @db.Uuid
  sortOrder        Int     @map("sort_order")

  session        WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise       Exercise?       @relation(fields: [exerciseId], references: [id])
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])
  sets           SessionSet[]

  @@index([sessionId, sortOrder])
  /// Progressao de carga (Fase 2.4): busca as series de um exercicio sem varrer todas as sessoes.
  @@index([exerciseId, sessionId])
  @@index([customExerciseId, sessionId])
  @@map("session_exercises")
}

/// Serie registrada de um exercicio da sessao. `reps`/`weightKg` >= 0 (0 kg = peso corporal).
model SessionSet {
  id                String  @id @default(uuid()) @db.Uuid
  sessionExerciseId String  @map("session_exercise_id") @db.Uuid
  setNumber         Int     @map("set_number")
  reps              Int
  weightKg          Float   @map("weight_kg")
  completed         Boolean @default(false)

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@map("session_sets")
}

/// Tipo de atividade livre (Fase 2.1). `userId` null = tipo padrao (seed, visivel a todos);
/// preenchido = tipo personalizado, visivel so ao dono. `slug` identifica os tipos padrao para
/// o upsert idempotente do seed e fica null nos personalizados (Postgres aceita varios nulls
/// num unique). Unicidade de nome entre padrao + custom do usuario e checada no servico.
model ActivityType {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  slug      String?  @unique @db.VarChar(80)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities FreeActivity[]

  @@index([userId])
  @@map("activity_types")
}

/// Atividade livre registrada pelo usuario (Fase 2.1) — natacao, futebol, corrida etc., fora
/// das planilhas de musculacao. `performedAt` segue a mesma regra das sessoes (retroativo
/// permitido, futuro rejeitado) e e o eixo do historico e do calendario (Fase 2.2).
/// FK do tipo em cascade (e nao restrict): tipo custom so some junto com o usuario, e com
/// RESTRICT o cascade de `users` falharia ao apagar o tipo antes das atividades que o usam.
model FreeActivity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  activityTypeId  String   @map("activity_type_id") @db.Uuid
  performedAt     DateTime @default(now()) @map("performed_at") @db.Timestamptz(3)
  durationMinutes Int      @map("duration_minutes")
  comment         String?  @db.VarChar(1000)
  photoUrl        String?  @map("photo_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
  @@index([activityTypeId])
  @@map("free_activities")
}

/// Trilha de auditoria do painel admin (Fase 3.1). Toda mutacao feita em `/admin/*` grava uma
/// linha aqui na mesma transacao da alteracao — nao existe acao admin sem registro.
/// `actor_id` em SET NULL (e nao cascade): apagar a conta do admin nao pode apagar o historico
/// do que ele fez. Null tambem identifica acoes feitas fora da API (`yarn user:set-role`).
/// `target_id` sem FK porque aponta para tabelas diferentes conforme `target_type`.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// Conquista cadastrada pelo admin (Fase 3.5). `criteria` e um JSON discriminado por `type`
/// (`streak_days` | `workout_count` | `challenge_complete`), validado por Zod na API — o motor
/// que avalia os criterios chega na Fase 4.1.
model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  iconUrl     String?  @map("icon_url")
  criteria    Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unlocks UserAchievement[]

  @@map("achievements")
}

/// Desafio com periodo definido (Fase 3.5). `goal` e um JSON discriminado por `type`
/// (`workout_count` | `activity_count` | `activity_minutes`). Participacao e progresso ficam em
/// `UserChallenge` (rotas de usuario na Fase 4.2).
model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  goal        Json
  reward      String?  @db.VarChar(255)
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants UserChallenge[]

  @@index([isActive, startsAt, endsAt])
  @@map("challenges")
}

/// Desbloqueio de conquista (estrutura base na 3.5; o insert idempotente vem na Fase 4.1).
model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId, unlockedAt])
  @@map("user_achievements")
}

/// Participacao em desafio (estrutura base na 3.5). `progress` na unidade do `goal` (treinos,
/// atividades ou minutos); `updatedAt` desempata o ranking da Fase 4.2.
model UserChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  challengeId String    @map("challenge_id") @db.Uuid
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId, progress, updatedAt])
  @@map("user_challenges")
}

/// Valores da API em maiusculas (como no seletor do app); no Postgres ficam em minusculas.
enum FoodUnit {
  G  @map("g")
  KG @map("kg")
  ML @map("ml")
  L  @map("l")

  @@map("food_unit")
}

/// Dieta do usuario (Nutricao). O usuario pode ter varias; no maximo uma ativa — garantido
/// no servico, que trava a linha do usuario antes de trocar a ativa (o Prisma nao gera
/// indice unico parcial `WHERE is_active`). Hard delete: nada referencia uma dieta.
model Diet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  goal      String?  @db.VarChar(255)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals DietMeal[]

  @@index([userId, isActive])
  @@map("diets")
}

/// Refeicao da dieta com horario `HH:mm` (hora local do usuario, sem fuso — e um horario
/// de rotina, nao um instante). `sortOrder` desempata refeicoes no mesmo horario.
model DietMeal {
  id        String @id @default(uuid()) @db.Uuid
  dietId    String @map("diet_id") @db.Uuid
  name      String @db.VarChar(80)
  time      String @db.VarChar(5)
  sortOrder Int    @map("sort_order")

  diet  Diet       @relation(fields: [dietId], references: [id], onDelete: Cascade)
  foods DietFood[]

  @@index([dietId, time, sortOrder])
  @@map("diet_meals")
}

/// Alimento de uma refeicao. `kcal` e a energia da porcao inteira (quantidade informada),
/// digitada pelo usuario ou sugerida pela IA (`POST /diets/calorie-estimate`).
model DietFood {
  id        String   @id @default(uuid()) @db.Uuid
  mealId    String   @map("meal_id") @db.Uuid
  name      String   @db.VarChar(120)
  quantity  Float
  unit      FoodUnit
  kcal      Int
  sortOrder Int      @map("sort_order")

  meal DietMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId, sortOrder])
  @@map("diet_foods")
}

enum RatingPlatform {
  mobile
  web

  @@map("rating_platform")
}

/// Avaliacao do app feita pelo usuario: nota 1–5 (CHECK no banco, alem do Zod), observacao
/// opcional e de onde veio (plataforma + aparelho). So insercao: o usuario nao edita nem le
/// as proprias avaliacoes; a leitura e do painel admin (`GET /admin/ratings`).
model Rating {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  rank        Int                @db.SmallInt
  observation String?            @db.VarChar(2000)
  platform    RatingPlatform
  device      String             @db.VarChar(120)
  date        DateTime           @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId, date])
  @@map("ratings")
}
