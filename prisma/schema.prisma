// Schema do Prisma para o Forma.
// Convencao: modelos em PascalCase no client, tabelas/colunas em snake_case no Postgres (@map/@@map).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // moduleResolution NodeNext exige a extensao .js nos imports relativos do codigo gerado
  importFileExtension = "js"
}

// Prisma 7 removeu `url` daqui: a conexao vem do driver adapter definido em prisma.config.ts
datasource db {
  provider = "postgresql"
}

/// Arquivo binario armazenado no proprio Postgres (bytea).
/// Fase 0 nao usa S3/R2: o client envia base64, o servidor decodifica e persiste aqui.
/// `owner_id` referencia o futuro `users.id` (Fase 1.1) e por isso ainda nao tem FK.
model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  filename  String?  @db.VarChar(255)
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@map("media_assets")
}

enum Role {
  user
  admin
  super_user

  @@map("role")
}

enum UserStatus {
  active
  inactive
  banned

  @@map("user_status")
}

enum OAuthProvider {
  google
  apple

  @@map("oauth_provider")
}

/// Conta de usuario (Fase 1.1). Email/senha e OAuth (Google/Apple) convivem na mesma linha:
/// uma conta criada por um metodo pode ser vinculada ao outro sem duplicar o usuario.
/// `email` e sempre normalizado (lowercase) pela camada de aplicacao antes de gravar/ler —
/// evita depender de `citext` ou indice de expressao so para unicidade case-insensitive.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String?        @map("password_hash")
  oauthProvider OAuthProvider? @map("oauth_provider")
  oauthSubject  String?        @map("oauth_subject") @db.VarChar(255)
  role          Role           @default(user)
  status        UserStatus     @default(active)
  /// Incrementado no logout; refresh tokens carregam o valor vigente no momento da emissao
  /// (`tv`) e sao recusados se nao baterem — invalida toda sessao sem precisar de uma
  /// tabela de refresh tokens.
  tokenVersion  Int            @default(0) @map("token_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile           UserProfile?
  bodyMeasurements  BodyMeasurement[]

  @@unique([oauthProvider, oauthSubject])
  @@map("users")
}

/// Dados de perfil separados de `users` porque a Fase 1.2 adiciona medidas corporais aqui
/// sem inflar a tabela de autenticacao. `weightKg`..`chestCm` guardam sempre o valor mais
/// recente; o historico completo fica em `BodyMeasurement`.
model UserProfile {
  userId                String    @id @map("user_id") @db.Uuid
  displayName           String?   @map("display_name") @db.VarChar(120)
  avatarUrl             String?   @map("avatar_url")
  weightKg              Float?    @map("weight_kg")
  heightCm              Float?    @map("height_cm")
  waistCm               Float?    @map("waist_cm")
  chestCm               Float?    @map("chest_cm")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Historico append-only de medidas corporais (Fase 1.2). Cada `POST /profile/measurements`
/// cria uma linha aqui e sincroniza os campos atuais em `UserProfile`.
model BodyMeasurement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weightKg  Float?   @map("weight_kg")
  heightCm  Float?   @map("height_cm")
  waistCm   Float?   @map("waist_cm")
  chestCm   Float?   @map("chest_cm")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("body_measurements")
}
